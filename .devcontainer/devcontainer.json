{
  "name": "Vocabulary Notebook",
  "dockerComposeFile": "../compose.yaml",
  "service": "web",
  "workspaceFolder": "/app",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
